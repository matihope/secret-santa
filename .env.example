# Password for the website admin panel at /admin (leave empty to disable it).
SITE_ADMIN_PASSWORD=change-me-please

# Public URL of the site (needed for form submissions behind the proxy).
ORIGIN=https://santa.example.com

# Nginx Proxy Manager forwards the client IP in X-Forwarded-For (used for rate limiting).
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1

# Timezone used to enter and display dates.
TIMEZONE=Europe/Warsaw

# Cookies are HTTPS-only. Set to false only for plain-http testing on a LAN IP.
COOKIE_SECURE=true
